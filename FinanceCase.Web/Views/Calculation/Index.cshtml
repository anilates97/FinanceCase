@model FinanceCase.Web.ViewModels.CalculationPageViewModel

@{
    ViewData["Title"] = "Analytics Results";
    var hasActiveFilter = Model.StartPeriod.HasValue || Model.EndPeriod.HasValue;
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Analytics Reporting</p>
        <h1>Analytics Results</h1>
        <p>Dollarization, inflation adjustment and monthly time-series calculations.</p>
    </div>
</section>

@if (TempData["PipelineStatus"] is string pipelineStatus)
{
    <div class="dashboard-card pipeline-status-card mb-4">
        <div class="sync-banner sync-banner-info">
            <span class="status-dot"></span>
            <div>
                <strong>Pipeline completed</strong>
                <p>@pipelineStatus</p>
            </div>
        </div>
    </div>
}

<div class="dashboard-card filter-card mb-4">
    <div class="card-section">
        <form id="calculationFilterForm" method="get" class="row g-3 align-items-end" data-loading-form>
            <div class="col-md-4">
                <label class="form-label" for="startPeriod">Start Date</label>
                <input class="form-control" type="date" id="startPeriod" name="startPeriod" value="@(Model.StartPeriod?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="endPeriod">End Date</label>
                <input class="form-control" type="date" id="endPeriod" name="endPeriod" value="@(Model.EndPeriod?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-4">
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary" data-loading-label="Running report...">Run Report</button>
                    @if (hasActiveFilter)
                    {
                        <a class="btn btn-outline-secondary" asp-controller="Calculation" asp-action="Index">Show All Data</a>
                    }
                </div>
            </div>
        </form>
        <div class="refresh-strip">
            <span>The results panel refreshes periodically while this page remains open.</span>
            <span>Last refresh: <strong id="lastRefreshTime">-</strong></span>
        </div>
    </div>
</div>

<div id="resultsContainer">
    <partial name="_ResultsContent" model="Model" />
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let resultsChartInstance = null;
        document.querySelectorAll('[data-loading-form]').forEach((form) => {
            form.addEventListener('submit', () => {
                const button = form.querySelector('button[type="submit"]');
                if (!button) {
                    return;
                }

                button.textContent = button.dataset.loadingLabel || 'Processing...';
                button.disabled = true;
                button.classList.add('is-loading');
            });
        });

        function updateLastRefreshLabel() {
            const target = document.getElementById('lastRefreshTime');
            if (!target) {
                return;
            }

            target.textContent = new Intl.DateTimeFormat('en-US', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            }).format(new Date());
        }

        function initializeResultsChart() {
            const chartDataElement = document.getElementById('resultsChartData');
            const canvas = document.getElementById('resultsChart');

            if (!chartDataElement || !canvas) {
                if (resultsChartInstance) {
                    resultsChartInstance.destroy();
                    resultsChartInstance = null;
                }
                return;
            }

            const chartData = JSON.parse(chartDataElement.textContent);
            const ctx = canvas.getContext('2d');

            if (resultsChartInstance) {
                resultsChartInstance.destroy();
            }

            resultsChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: chartData.labels,
                    datasets: [
                        {
                            label: 'Asset Value',
                            data: chartData.assetSeries,
                            borderColor: '#6ea8fe',
                            backgroundColor: 'rgba(110, 168, 254, 0.16)',
                            fill: true,
                            tension: 0.35,
                            borderWidth: 2,
                            pointRadius: 0,
                            pointHoverRadius: 4,
                            pointBackgroundColor: '#dbeafe'
                        },
                        {
                            label: 'Dollarized Asset Value',
                            data: chartData.dollarizedSeries,
                            borderColor: '#f5c26b',
                            backgroundColor: 'rgba(245, 194, 107, 0.08)',
                            fill: false,
                            tension: 0.35,
                            borderWidth: 2,
                            pointRadius: 0,
                            pointHoverRadius: 4,
                            pointBackgroundColor: '#f5c26b'
                        },
                        {
                            label: 'Inflation Adjusted Value',
                            data: chartData.inflationSeries,
                            borderColor: '#6ee7b7',
                            backgroundColor: 'rgba(110, 231, 183, 0.08)',
                            fill: false,
                            tension: 0.35,
                            borderWidth: 2,
                            pointRadius: 0,
                            pointHoverRadius: 4,
                            pointBackgroundColor: '#6ee7b7'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: '#9aa8bd',
                                usePointStyle: true,
                                pointStyle: 'circle',
                                boxWidth: 8,
                                padding: 20,
                                font: {
                                    size: 12,
                                    weight: '600'
                                }
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(10, 15, 25, 0.96)',
                            titleColor: '#f8fafc',
                            bodyColor: '#cbd5e1',
                            borderColor: 'rgba(148, 163, 184, 0.18)',
                            borderWidth: 1,
                            padding: 12,
                            displayColors: true,
                            callbacks: {
                                label: function(context) {
                                    const value = context.parsed.y || 0;
                                    const formatted = new Intl.NumberFormat('en-US', {
                                        style: 'currency',
                                        currency: 'TRY',
                                        maximumFractionDigits: 0
                                    }).format(value);

                                    return `${context.dataset.label}: ${formatted}`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                color: 'rgba(148, 163, 184, 0.06)'
                            },
                            ticks: {
                                color: '#7f8ea3',
                                maxRotation: 0,
                                autoSkipPadding: 22
                            }
                        },
                        y: {
                            border: {
                                color: 'rgba(148, 163, 184, 0.08)'
                            },
                            grid: {
                                color: 'rgba(148, 163, 184, 0.08)'
                            },
                            ticks: {
                                color: '#7f8ea3',
                                callback: function(value) {
                                    return new Intl.NumberFormat('en-US', {
                                        style: 'currency',
                                        currency: 'TRY',
                                        maximumFractionDigits: 0
                                    }).format(value);
                                }
                            }
                        }
                    }
                }
            });
        }

        async function refreshResultsSilently() {
            const form = document.getElementById('calculationFilterForm');
            const container = document.getElementById('resultsContainer');
            const params = new URLSearchParams(new FormData(form));

            try {
                const response = await fetch(`/Calculation/LiveResults?${params.toString()}`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (!response.ok) {
                    return;
                }

                container.innerHTML = await response.text();
                initializeResultsChart();
                updateLastRefreshLabel();
            } catch {
                // keep the current results visible if live refresh fails
            }
        }

        initializeResultsChart();
        updateLastRefreshLabel();
        window.setInterval(refreshResultsSilently, 60000);
    </script>
}
