@model FinanceCase.Web.ViewModels.ExchangeRatesPageViewModel

@{
    ViewData["Title"] = "Exchange Rates";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Exchange Rate Operations</p>
        <h1>Exchange Rate Records</h1>
        <p>Exchange-rate records stored in the database and hourly Hangfire synchronization status.</p>
    </div>
</section>

<section class="metric-grid metric-grid-compact">
    <div class="metric-card">
        <span class="metric-label">Exchange Rate Records</span>
        <strong>@Model.TotalCount.ToString("N0")</strong>
        <span class="metric-note">Processed records</span>
    </div>
    <div class="metric-card">
        <span class="metric-label">Current Page</span>
        <strong>@Model.CurrentPage / @Model.TotalPages</strong>
        <span class="metric-note">@Model.PageSize.ToString("N0") rows per page</span>
    </div>
    <div class="metric-card">
        <span class="metric-label">Last Sync Timestamp</span>
        <strong>@(Model.LastRateDataAt?.ToString("MM/dd/yyyy HH:mm") ?? "-")</strong>
        <span class="metric-note">Source API record time</span>
    </div>
</section>

<div class="dashboard-card mb-4">
    <div class="sync-banner">
        <span class="status-dot"></span>
        <div>
            <strong>Automatic exchange-rate updates are active</strong>
            <p>
            Exchange-rate data is refreshed hourly through Hangfire.
            @if (Model.LastRateDataAt.HasValue)
            {
                <span class="d-inline-block ms-2">
                    Last source timestamp: <strong>@Model.LastRateDataAt.Value.ToString("MM/dd/yyyy HH:mm")</strong>
                </span>
                <span class="d-inline-block ms-2 muted">
                    Timestamp from the source API record.
                </span>
            }
            </p>
        </div>
    </div>
</div>

<div id="exchangeRatesTableContainer">
    <partial name="_ExchangeRatesTable" model="Model" />
</div>

@section Scripts {
    <script>
        async function loadExchangeRatesPage(page) {
            const container = document.getElementById('exchangeRatesTableContainer');

            try {
                const response = await fetch(`/ExchangeRates/Table?page=${page}`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (!response.ok) {
                    return;
                }

                container.innerHTML = await response.text();
                container.scrollIntoView({ behavior: 'smooth', block: 'start' });
            } catch {
                // keep the current table visible if refresh fails
            }
        }

        document.addEventListener('click', function (event) {
            const link = event.target.closest('[data-exchange-page]');
            if (!link) {
                return;
            }

            event.preventDefault();
            const page = link.getAttribute('data-exchange-page');
            if (page) {
                loadExchangeRatesPage(page);
            }
        });
    </script>
}
