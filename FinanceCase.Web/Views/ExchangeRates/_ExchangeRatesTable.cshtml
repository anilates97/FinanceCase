@model FinanceCase.Web.ViewModels.ExchangeRatesPageViewModel

@{
    var en = new System.Globalization.CultureInfo("en-US");
    var pagesToShow = new SortedSet<int>();
    if (Model.TotalPages > 0)
    {
        pagesToShow.Add(1);
        pagesToShow.Add(Model.TotalPages);

        for (var i = Model.CurrentPage - 1; i <= Model.CurrentPage + 1; i++)
        {
            if (i >= 1 && i <= Model.TotalPages)
            {
                pagesToShow.Add(i);
            }
        }
    }

    var orderedPages = pagesToShow.OrderBy(x => x).ToList();
}

<div class="dashboard-card data-table-card">
    <div class="table-toolbar">
        <div>
            <span class="metric-label">Exchange Rate Dataset</span>
            <strong>Total Records: @Model.TotalCount.ToString("N0", en)</strong>
        </div>
        <span class="status-pill status-idle">Page @Model.CurrentPage / @Model.TotalPages</span>
    </div>
    <div class="table-responsive analytics-table-wrap has-edge-fade">
        @if (Model.Rates.Count == 0)
        {
            <div class="empty-state empty-state-inline">
                <p class="eyebrow">No Exchange Rates</p>
                <h2>No exchange-rate records are available.</h2>
                <p>Load the demo dataset or run the import pipeline to prepare exchange-rate data.</p>
            </div>
        }
        else
        {
        <table class="table analytics-table has-sticky-column mb-0">
            <thead>
                <tr>
                    <th>Base</th>
                    <th>Foreign</th>
                    <th class="text-end">Change Rate</th>
                    <th class="text-end">Exchange Rate</th>
                    <th class="text-end">Cash Change</th>
                    <th class="text-end">Cash Exchange</th>
                    <th class="text-end">Cross Rate</th>
                    <th>Current Date</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Rates)
            {
                <tr>
                    <td><span class="code-chip">@item.BaseCurrencyCode</span></td>
                    <td><span class="code-chip">@item.ForeignCurrencyCode</span></td>
                    <td class="numeric @(item.ChangeRate >= 0 ? "is-positive" : "is-negative")">@item.ChangeRate.ToString("N4", en)</td>
                    <td class="numeric">@item.ExchangeRateValue.ToString("N4", en)</td>
                    <td class="numeric @(item.CashChangeRate >= 0 ? "is-positive" : "is-negative")">@item.CashChangeRate.ToString("N4", en)</td>
                    <td class="numeric">@item.CashExchangeRate.ToString("N4", en)</td>
                    <td class="numeric">@item.CrossRate.ToString("N4", en)</td>
                    <td>@item.CurrentDate.ToString("MM/dd/yyyy HH:mm")</td>
                </tr>
            }
            </tbody>
        </table>
        }
    </div>
    <div class="table-pagination">
        <nav aria-label="Exchange-rate records pagination">
            <ul class="pagination mb-0 flex-wrap justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : string.Empty)">
                    <a class="page-link" href="#" data-exchange-page="@(Model.CurrentPage - 1)">Previous</a>
                </li>
                @for (var index = 0; index < orderedPages.Count; index++)
                {
                    var pageNumber = orderedPages[index];

                    if (index > 0 && pageNumber - orderedPages[index - 1] > 1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }

                    <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : string.Empty)">
                        <a class="page-link" href="#" data-exchange-page="@pageNumber">@pageNumber</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : string.Empty)">
                    <a class="page-link" href="#" data-exchange-page="@(Model.CurrentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    </div>
</div>
