@using FinanceCase.Web.Services
@inject IAppStateService AppStateService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FinanceCase</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FinanceCase.Web.styles.css" asp-append-version="true" />
</head>
<body class="dashboard-shell">
    @{ var isDataReady = await AppStateService.IsDataReadyAsync(); }
    <header class="app-header">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark">
            <div class="container-fluid px-4">
                <a class="navbar-brand app-brand" asp-area="" asp-controller="@(isDataReady ? "Calculation" : "Import")" asp-action="Index">
                    <span class="brand-mark">FC</span>
                    <span>
                        <span class="brand-title">FinanceCase</span>
                        <span class="brand-subtitle">Financial Data Processing & Analytics Platform</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav ms-sm-auto app-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Import" asp-action="Index">Import</a>
                        </li>
                        @if (isDataReady)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Calculation" asp-action="Index">Analytics</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="ExchangeRates" asp-action="Index">Exchange Rates</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-4 app-frame">
        <main role="main" class="app-main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer app-footer">
        <div class="container-fluid px-4">
            &copy; 2026 - FinanceCase Operations
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
