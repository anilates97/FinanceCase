@model ErrorViewModel
@{
    ViewData["Title"] = "Operational Error";
}

<div class="dashboard-card error-panel">
    <div class="card-section">
        <p class="eyebrow">System Event</p>
        <h1>We could not complete this operation.</h1>
        <p>The platform encountered an unexpected processing issue. No partial workflow state is shown here; please retry the operation or return to the import pipeline.</p>

        @if (Model.ShowRequestId)
        {
            <div class="request-id">
                <span class="metric-label">Request ID</span>
                <code>@Model.RequestId</code>
            </div>
        }

        <div class="error-actions">
            <a class="btn btn-primary" asp-controller="Import" asp-action="Index">Return to Import Pipeline</a>
            <a class="btn btn-outline-secondary" asp-controller="Calculation" asp-action="Index">Open Analytics</a>
        </div>
    </div>
</div>
