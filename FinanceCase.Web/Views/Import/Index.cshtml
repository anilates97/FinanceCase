@model FinanceCase.Web.ViewModels.ImportFilesViewModel
@inject IWebHostEnvironment Environment

@{
    ViewData["Title"] = "Veri Yükleme";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-3">
                    <div>
                        <h1 class="h3 mb-2">Excel Veri Yükleme</h1>
                        <p class="text-muted mb-0">Varlık tablosu ve ÜFE endeks tablosunu birlikte yükleyin. Yükleme sonrası ilgili tarih aralığının kur verileri otomatik senkronlanır.</p>
                    </div>

                    @if (Environment.IsDevelopment())
                    {
                        <form asp-action="ClearData" method="post" onsubmit="return confirm('Tüm veriler silinsin mi?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger">Tüm Verileri Temizle</button>
                        </form>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                {
                    <div class="alert alert-success">
                        <div>@Model.SuccessMessage</div>
                        @if (Model.ShouldRedirectToExchangeRates)
                        {
                            <div class="mt-2 small fw-semibold">
                                <span id="redirectCountdown">@Model.RedirectDelaySeconds</span> saniye içinde Kurlar sayfasına yönlendiriliyorsunuz...
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.InfoMessage))
                {
                    <div class="alert alert-info">@Model.InfoMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                <form asp-action="Index" method="post" enctype="multipart/form-data" class="row g-3">
                    <div class="col-12">
                        <label asp-for="AssetFile" class="form-label">Varlık Dosyası</label>
                        <input asp-for="AssetFile" class="form-control" accept=".xls,.xlsx" />
                    </div>

                    <div class="col-12">
                        <label asp-for="InflationFile" class="form-label">ÜFE Endeks Dosyası</label>
                        <input asp-for="InflationFile" class="form-control" accept=".xls,.xlsx" />
                    </div>

                    <div class="col-12 d-grid">
                        <button type="submit" class="btn btn-primary">Dosyaları Yükle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@if (Model.ShouldRedirectToExchangeRates)
{
    @section Scripts {
        <script>
            (() => {
                const countdownElement = document.getElementById('redirectCountdown');
                if (!countdownElement) {
                    return;
                }

                let secondsRemaining = Number(countdownElement.textContent);

                // başarılı import sonrası kullanıcıyı otomatik olarak kurlar ekranına yönlendirir
                const intervalId = window.setInterval(() => {
                    secondsRemaining -= 1;

                    if (secondsRemaining <= 0) {
                        window.clearInterval(intervalId);
                        window.location.href = '@Url.Action("Index", "ExchangeRates")';
                        return;
                    }

                    countdownElement.textContent = String(secondsRemaining);
                }, 1000);
            })();
        </script>
    }
}
